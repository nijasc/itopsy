# Postgres connection string (Neon or Supabase)
DATABASE_URL=postgres://user:password@host:5432/dbname

# The one email address allowed to become the site owner when it registers.
# Leave it unset and nobody can claim the owner role through the signup form.
OWNER_EMAIL=you@example.com

# Secret used to sign/hash Lucia session-related tokens
AUTH_SECRET=change-me-to-a-long-random-string
